{
  "name": "localpulse",
  "version": "0.1.0",
  "description": "A tiny, type-safe localStorage observer with cross-tab synchronization.",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm run build && changeset publish"
  },
  "keywords": [
    "localstorage",
    "storage",
    "state",
    "state-management",
    "observer",
    "observable",
    "reactive",
    "sync",
    "cross-tab",
    "persistence",
    "browser-storage",
    "typescript",
    "typed",
    "ssr-safe",
    "frontend",
    "client-state",
    "storage-observer",
    "web-storage",
    "tiny",
    "lightweight"
  ],
  "author": "Abbas Roholamin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbas-roholamin/localpulse.git"
  },
  "homepage": "https://github.com/abbas-roholamin/localpulse#readme",
  "bugs": {
    "url": "https://github.com/abbas-roholamin/localpulse/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
